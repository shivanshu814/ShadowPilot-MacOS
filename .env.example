# ─────────────────────────────────────────────────────────────
#  ShadowPilot — Environment Variables
# ─────────────────────────────────────────────────────────────
#  Copy this file as `.env` in the project root and fill in
#  at least ONE API key. Priority order: Bedrock → OpenRouter → OpenAI
# ─────────────────────────────────────────────────────────────

# AWS Bedrock (Meta Llama 3.3 70B — fastest + most capable)
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1

# OpenRouter (GPT-4o via OpenRouter proxy)
OPENROUTER_API_KEY=

# OpenAI (direct GPT-4o)
OPENAI_API_KEY=
